# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Required in production -------------------------------------------------

PORTAL_ENVIRONMENT=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PORTAL_SECRET_KEY=

# --- Storage -----------------------------------------------------------

# Must be a persistent, writable volume in any real deployment. The app
# fails to start if this is not writable. See docs/portal-deployment.md.
PORTAL_DATA_DIR=/data

# Defaults to sqlite:///{PORTAL_DATA_DIR}/portal.db if unset. Only change
# this if you have a specific reason to point at a different database file.
# PORTAL_DATABASE_URL=

# --- Admin bootstrap (used only by `portal-create-admin`, not read at
# runtime by the web app) ---------------------------------------------------

# If unset, `portal-create-admin` prompts interactively (input hidden).
# PORTAL_ADMIN_PASSWORD=

# --- Upload limits -----------------------------------------------------

PORTAL_MAX_UPLOAD_BYTES=15728640
PORTAL_MAX_IMAGES_PER_PROJECT=12
PORTAL_MIN_IMAGE_DIMENSION_PX=400
PORTAL_INVITATION_EXPIRY_DAYS=30

# --- Session / cookies ---------------------------------------------------

PORTAL_SESSION_COOKIE_NAME=portal_admin_session
PORTAL_SESSION_MAX_AGE_SECONDS=28800

# --- Rate limiting (pilot-grade, in-memory - see docs/portal-architecture.md)

PORTAL_RATE_LIMIT_MAX_ATTEMPTS=10
PORTAL_RATE_LIMIT_WINDOW_SECONDS=60

# --- Contributor form -----------------------------------------------------

PORTAL_CONTACT_EMAIL_COLLECTION_ENABLED=true
