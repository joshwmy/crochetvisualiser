{
  "$defs": {
    "ClassificationMethod": {
      "description": "Which extraction stage produced a symbol's classification.\n\nOrdering below (top to bottom) is the deterministic priority order used\nby ``diagram/extraction.py`` \u2014 never let a later (lower-confidence)\nmethod override an earlier one. See ``CONFIDENCE_BY_METHOD``.",
      "enum": [
        "data_attribute",
        "use_reference",
        "element_id",
        "css_class",
        "title",
        "aria_label",
        "primitive_geometry",
        "manual_override",
        "unclassified"
      ],
      "title": "ClassificationMethod",
      "type": "string"
    },
    "ComponentKind": {
      "description": "Beanie components (``CROWN``/``BODY``/``BRIM``) plus ``PIECE``.\n\n``PIECE`` is one undifferentiated worked piece with no crown/body/brim\ndistinction, used by the written-pattern parser (``parsing/written/``)\nfor generic round-based patterns (amigurumi, swatches) that aren't\nbeanies. The rotational geometry layout treats ``PIECE`` the same as\n``BODY`` (a flat vertical stack of rounds, no dome curvature) \u2014 a known,\ndocumented approximation for shapes like a sphere, where a real\ncrown-and-decrease-symmetric dome treatment would render more\naccurately. See docs/known-limitations.md.",
      "enum": [
        "crown",
        "body",
        "brim",
        "piece"
      ],
      "title": "ComponentKind",
      "type": "string"
    },
    "ConstructionMode": {
      "description": "Only ``CIRCULAR`` is implemented this slice (brief: \"first topology\nimplementation should target circular or radial charts\"). ``ROW`` is\nreserved so the schema does not need a breaking change later, the same\npattern ``domain.enums.Construction.JOINED`` already uses \u2014 selecting a\nchart this pipeline detects as row/flat-panel construction produces an\nexplicit ``UNSUPPORTED_CHART_CONSTRUCTION`` diagnostic, never a silent\nbest-effort circular interpretation.",
      "enum": [
        "circular",
        "row"
      ],
      "title": "ConstructionMode",
      "type": "string"
    },
    "DiagramCompileSummary": {
      "properties": {
        "componentCount": {
          "title": "Componentcount",
          "type": "integer"
        },
        "geometryFingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Geometryfingerprint"
        },
        "graphFingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Graphfingerprint"
        },
        "sectionCount": {
          "title": "Sectioncount",
          "type": "integer"
        },
        "stitchCount": {
          "title": "Stitchcount",
          "type": "integer"
        }
      },
      "required": [
        "sectionCount",
        "stitchCount",
        "componentCount",
        "graphFingerprint",
        "geometryFingerprint"
      ],
      "title": "DiagramCompileSummary",
      "type": "object"
    },
    "DiagramConstruction": {
      "properties": {
        "centre": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Centre"
        },
        "centre_method": {
          "anyOf": [
            {
              "enum": [
                "explicit_metadata",
                "explicit_symbol",
                "user_specified",
                "geometric_estimate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Centre Method"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "clockwise",
                "counterclockwise"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "mode": {
          "$ref": "#/$defs/ConstructionMode"
        },
        "round_tolerance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round Tolerance"
        },
        "start_symbol_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Symbol Id"
        }
      },
      "required": [
        "mode"
      ],
      "title": "DiagramConstruction",
      "type": "object"
    },
    "DiagramDiagnostic": {
      "description": "One structured diagram-pipeline diagnostic.\n\nOrdering is always the order diagnostics were produced during a single\ndeterministic pass (parse -> extract -> classify -> topology -> convert)\n\u2014 never re-sorted, so identical input always produces an identically\nordered diagnostics list, matching the written-pattern parser's\nconvention.",
      "properties": {
        "code": {
          "$ref": "#/$defs/DiagramDiagnosticCode"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "element_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Path"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "round_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round Index"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggested_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Action"
        },
        "svg_element_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Svg Element Id"
        },
        "symbol_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol Id"
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ],
      "title": "DiagramDiagnostic",
      "type": "object"
    },
    "DiagramDiagnosticCode": {
      "enum": [
        "INVALID_SVG",
        "UNSAFE_SVG_CONTENT",
        "UNSUPPORTED_SVG_FEATURE",
