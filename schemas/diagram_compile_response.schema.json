    "StitchNode": {
      "description": "One individually identified worked stitch.",
      "properties": {
        "colour_id": {
          "default": "main",
          "title": "Colour Id",
          "type": "string"
        },
        "component_kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "decrease_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
