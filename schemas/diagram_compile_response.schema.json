      "required": [
        "stitch_id",
        "component_kind",
        "round_number",
        "position_in_round",
        "sequence_index",
        "stitch_type",
        "stitch_height_category",
        "loop_placement",
        "source_reference"
      ],
      "title": "StitchNode",
      "type": "object"
    },
    "YarnSegment": {
      "description": "A simplified structural piece of yarn path owned by one stitch.\n\nThe first slice models only a single ``connector`` segment per\nyarn-sequence edge (previous stitch -> this stitch). Richer semantic\nsegmentation (entry/lower-loop/post/upper-loop/exit) is deferred to a\nlater slice, per the data model note in the geometry/rendering spec \u2014\nthis type is intentionally narrow, not final.",
      "properties": {
        "from_stitch_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Stitch Id"
        },
        "owning_stitch_id": {
          "title": "Owning Stitch Id",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "segment_type": {
          "const": "connector",
          "default": "connector",
          "title": "Segment Type",
          "type": "string"
        },
        "to_stitch_id": {
          "title": "To Stitch Id",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "owning_stitch_id",
        "to_stitch_id"
      ],
      "title": "YarnSegment",
      "type": "object"
    },
    "YarnSegmentGeometry": {
      "description": "Simplified curve for one yarn segment: a straight line between two stitches.\n\nFirst-slice simplification: two control points (start, end), not a full\nCatmull-Rom/Bezier centreline. See package docstring for what a later\nprocedural-yarn slice would add here without changing the schema shape\n(more control points, same record type).",
      "properties": {
        "control_points": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Control Points",
          "type": "array"
        },
        "from_stitch_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "From Stitch Id"
        },
        "owning_stitch_id": {
          "title": "Owning Stitch Id",
          "type": "string"
        },
        "radius_cm": {
          "exclusiveMinimum": 0,
          "title": "Radius Cm",
          "type": "number"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "segment_type": {
          "default": "connector",
          "title": "Segment Type",
          "type": "string"
        },
        "to_stitch_id": {
          "title": "To Stitch Id",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "owning_stitch_id",
        "from_stitch_id",
        "to_stitch_id",
        "control_points",
        "radius_cm"
      ],
      "title": "YarnSegmentGeometry",
      "type": "object"
    }
  },
