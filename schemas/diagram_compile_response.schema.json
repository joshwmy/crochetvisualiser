            "type": "string"
          },
          "title": "Parent Stitch Ids",
          "type": "array"
        },
        "position_in_round": {
          "description": "0-indexed position within the round.",
          "minimum": 0,
          "title": "Position In Round",
          "type": "integer"
        },
        "repeat_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID of the RepeatOp iteration this stitch belongs to, if any.",
          "title": "Repeat Group Id"
        },
        "round_number": {
          "minimum": 1,
          "title": "Round Number",
          "type": "integer"
        },
        "sequence_index": {
          "description": "0-indexed global working order.",
          "minimum": 0,
          "title": "Sequence Index",
          "type": "integer"
        },
        "source_reference": {
          "description": "e.g. \"crown round 3 operation 2 (repeat 4/8)\".",
          "title": "Source Reference",
          "type": "string"
        },
        "stitch_height_category": {
          "enum": [
            "short",
            "medium",
            "tall"
          ],
          "title": "Stitch Height Category",
          "type": "string"
        },
        "stitch_id": {
          "description": "Stable ID, e.g. \"body-r04-s018\".",
          "title": "Stitch Id",
          "type": "string"
        },
        "stitch_type": {
          "$ref": "#/$defs/StitchFamily"
        },
        "target_rule": {
          "default": "deterministic_left_to_right",
          "enum": [
            "explicit",
            "deterministic_left_to_right"
          ],
          "title": "Target Rule",
          "type": "string"
        },
        "yarn_id": {
          "default": "main",
          "description": "Phase 1 supports solid-colour single yarn.",
          "title": "Yarn Id",
          "type": "string"
