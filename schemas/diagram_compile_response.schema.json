        },
        "into_ring": {
          "default": false,
          "description": "True for round-1 stitches worked into a magic ring.",
          "title": "Into Ring",
          "type": "boolean"
        },
        "is_decrease": {
          "default": false,
          "title": "Is Decrease",
          "type": "boolean"
        },
        "is_increase": {
          "default": false,
          "title": "Is Increase",
          "type": "boolean"
        },
        "loop_placement": {
          "$ref": "#/$defs/LoopPlacement"
