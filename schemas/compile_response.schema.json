{
  "$defs": {
    "CompileSummary": {
      "properties": {
        "componentCount": {
          "title": "Componentcount",
          "type": "integer"
        },
        "geometryFingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Geometryfingerprint"
        },
        "graphFingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Graphfingerprint"
        },
        "sectionCount": {
          "title": "Sectioncount",
          "type": "integer"
        },
        "stitchCount": {
          "title": "Stitchcount",
          "type": "integer"
        }
      },
      "required": [
        "sectionCount",
        "stitchCount",
        "componentCount",
        "graphFingerprint",
        "geometryFingerprint"
      ],
      "title": "CompileSummary",
      "type": "object"
    },
    "ComponentKind": {
      "description": "Beanie components (``CROWN``/``BODY``/``BRIM``) plus ``PIECE``.\n\n``PIECE`` is one undifferentiated worked piece with no crown/body/brim\ndistinction, used by the written-pattern parser (``parsing/written/``)\nfor generic round-based patterns (amigurumi, swatches) that aren't\nbeanies. The rotational geometry layout treats ``PIECE`` the same as\n``BODY`` (a flat vertical stack of rounds, no dome curvature) \u2014 a known,\ndocumented approximation for shapes like a sphere, where a real\ncrown-and-decrease-symmetric dome treatment would render more\naccurately. See docs/known-limitations.md.",
      "enum": [
        "crown",
        "body",
        "brim",
        "piece"
      ],
      "title": "ComponentKind",
      "type": "string"
    },
    "ComponentsPayload": {
      "description": "The compiled crochet structure: ``list[Component]``, not a full beanie\n``Pattern`` \u2014 a written pattern has no ``ProjectInput``/\n``CalculatedParameters`` (beanie-sizing fields that don't apply here).\nSee docs/crochet-ir-spec.md.",
      "properties": {
        "components": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "components"
      ],
      "title": "ComponentsPayload",
      "type": "object"
    },
    "Diagnostic": {
      "description": "One structured parser/compiler diagnostic.\n\nOrdering is always: the order diagnostics were produced during a single\ndeterministic left-to-right pass over the source (section by section,\ntop to bottom) \u2014 never re-sorted afterward, so identical input always\nproduces an identically-ordered diagnostics list.",
      "properties": {
        "actual": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "code": {
          "$ref": "#/$defs/DiagnosticCode"
        },
        "column": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "expected": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "DiagnosticCode": {
      "enum": [
        "INVALID_SYNTAX",
        "UNSUPPORTED_SYNTAX",
        "AMBIGUOUS_SYNTAX",
        "UNKNOWN_ABBREVIATION",
        "MISSING_FOUNDATION",
        "INVALID_RANGE",
        "INVALID_REPEAT",
        "STITCH_COUNT_MISMATCH",
        "INSUFFICIENT_PARENT_STITCHES",
        "INVALID_INCREASE",
        "INVALID_DECREASE",
        "GRAPH_VALIDATION_FAILURE",
        "GEOMETRY_GENERATION_FAILURE",
        "INTERNAL_SERVER_FAILURE",
        "EMPTY_INPUT",
        "INPUT_TOO_LARGE",
        "INVALID_TERMINOLOGY",
        "ASSUMPTION_APPLIED",
        "STRICT_MODE_BLOCKED"
      ],
      "title": "DiagnosticCode",
      "type": "string"
    },
    "Edge": {
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "edge_type": {
          "enum": [
            "yarn_sequence",
            "insertion",
            "horizontal_neighbor",
            "round_closure"
          ],
          "title": "Edge Type",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "edge_type",
        "source_id",
        "target_id"
      ],
      "title": "Edge",
      "type": "object"
    },
    "GaugeAssumptions": {
      "properties": {
        "rounds_per_cm": {
          "title": "Rounds Per Cm",
          "type": "number"
        },
        "stitches_per_cm": {
          "title": "Stitches Per Cm",
          "type": "number"
        },
        "yarn_diameter_cm": {
          "title": "Yarn Diameter Cm",
          "type": "number"
        }
      },
      "required": [
        "stitches_per_cm",
        "rounds_per_cm",
        "yarn_diameter_cm"
      ],
      "title": "GaugeAssumptions",
      "type": "object"
    },
    "GeometryBounds": {
      "properties": {
        "max": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Max",
          "type": "array"
        },
        "min": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Min",
          "type": "array"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "GeometryBounds",
      "type": "object"
    },
    "GeometryDocument": {
      "description": "The complete renderer-ready geometry payload for one compiled pattern.",
      "properties": {
        "bounds": {
          "$ref": "#/$defs/GeometryBounds"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/GeometryEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "gauge": {
          "$ref": "#/$defs/GaugeAssumptions"
        },
        "geometry_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geometry Fingerprint"
        },
        "graph_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Graph Fingerprint"
        },
        "measurements": {
          "$ref": "#/$defs/GeometryMeasurements"
        },
        "pattern_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pattern Fingerprint"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stitches": {
          "items": {
            "$ref": "#/$defs/StitchGeometry"
          },
          "title": "Stitches",
          "type": "array"
        },
        "units": {
          "default": "cm",
          "title": "Units",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "yarn_segments": {
          "items": {
            "$ref": "#/$defs/YarnSegmentGeometry"
          },
          "title": "Yarn Segments",
          "type": "array"
        }
      },
      "required": [
        "pattern_fingerprint",
        "graph_fingerprint",
        "gauge",
        "stitches",
        "yarn_segments",
        "edges",
        "bounds",
        "measurements"
      ],
      "title": "GeometryDocument",
      "type": "object"
    },
    "GeometryEdge": {
      "description": "A graph edge carried through for graph-mode rendering.",
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "edge_type": {
          "title": "Edge Type",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "edge_type",
        "source_id",
        "target_id"
      ],
      "title": "GeometryEdge",
      "type": "object"
    },
    "GeometryMeasurements": {
      "description": "Dimensions derived from the placed geometry \u2014 always approximate.\n\nThese are estimates from analytical stitch placement, not measurements\nof a physical object; the viewer must label them as estimated wherever\ndisplayed (see docs/geometry-transfer-spec.md, \"Estimated, not measured\").",
      "properties": {
        "max_circumference_cm": {
          "title": "Max Circumference Cm",
          "type": "number"
        },
        "max_radius_cm": {
          "title": "Max Radius Cm",
          "type": "number"
        },
        "overall_height_cm": {
          "title": "Overall Height Cm",
          "type": "number"
        }
      },
      "required": [
        "overall_height_cm",
        "max_radius_cm",
        "max_circumference_cm"
      ],
      "title": "GeometryMeasurements",
      "type": "object"
    },
    "LoopPlacement": {
      "description": "Which loop(s) a stitch is worked into.",
      "enum": [
        "both",
        "front_loop_only",
        "back_loop_only"
      ],
      "title": "LoopPlacement",
      "type": "string"
    },
    "StitchFamily": {
      "description": "Supported body stitches.\n\n``SC``/``HDC`` are the Phase 1 beanie engine's vocabulary (see\n``engine/crown.py``/``engine/body.py``). ``DC`` was added for the\nwritten-pattern parser (``parsing/written/``), which needs it for its\ndocumented abbreviation list; the beanie engine still never emits it.",
      "enum": [
        "sc",
        "hdc",
        "dc"
      ],
      "title": "StitchFamily",
      "type": "string"
    },
    "StitchGeometry": {
      "description": "Position, orientation, and metadata for one stitch, ready to render.",
      "properties": {
        "binormal": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Binormal",
          "type": "array"
        },
        "colour_id": {
          "title": "Colour Id",
          "type": "string"
        },
        "component_id": {
          "description": "Currently the component kind, e.g. 'crown'.",
          "title": "Component Id",
          "type": "string"
        },
        "is_decrease": {
          "title": "Is Decrease",
          "type": "boolean"
        },
        "is_increase": {
          "title": "Is Increase",
          "type": "boolean"
        },
        "loop_placement": {
          "$ref": "#/$defs/LoopPlacement"
        },
        "normal": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Normal",
          "type": "array"
        },
        "orientation": {
          "description": "Unit quaternion (x, y, z, w).",
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Orientation",
          "type": "array"
        },
        "parent_stitch_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Stitch Ids",
          "type": "array"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "round_index": {
          "title": "Round Index",
          "type": "integer"
        },
        "scale": {
          "default": 1.0,
          "title": "Scale",
          "type": "number"
        },
        "sequence_index": {
          "title": "Sequence Index",
          "type": "integer"
        },
        "source_reference": {
          "title": "Source Reference",
          "type": "string"
        },
        "stitch_id": {
          "title": "Stitch Id",
          "type": "string"
        },
        "stitch_type": {
          "$ref": "#/$defs/StitchFamily"
        },
        "tangent": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Tangent",
          "type": "array"
        },
        "yarn_id": {
          "title": "Yarn Id",
          "type": "string"
        }
      },
      "required": [
        "stitch_id",
        "component_id",
        "stitch_type",
        "round_index",
        "sequence_index",
        "position",
        "orientation",
        "tangent",
        "normal",
        "binormal",
        "loop_placement",
        "colour_id",
        "yarn_id",
        "parent_stitch_ids",
        "is_increase",
        "is_decrease",
        "source_reference"
      ],
      "title": "StitchGeometry",
      "type": "object"
    },
    "StitchGraph": {
      "description": "The complete deterministic stitch graph for one compiled pattern.",
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "title": "Edges",
          "type": "array"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/StitchNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "pattern_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pattern Fingerprint"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "yarn_segments": {
          "items": {
            "$ref": "#/$defs/YarnSegment"
          },
          "title": "Yarn Segments",
          "type": "array"
        }
      },
      "required": [
        "pattern_fingerprint",
        "nodes",
        "edges",
        "yarn_segments"
      ],
      "title": "StitchGraph",
      "type": "object"
    },
    "StitchNode": {
      "description": "One individually identified worked stitch.",
      "properties": {
        "colour_id": {
          "default": "main",
          "title": "Colour Id",
          "type": "string"
        },
        "component_kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "decrease_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decrease Group Id"
        },
        "diagram_symbol_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diagram Symbol Reference"
        },
        "increase_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Increase Group Id"
        },
        "into_ring": {
          "default": false,
          "description": "True for round-1 stitches worked into a magic ring.",
          "title": "Into Ring",
          "type": "boolean"
        },
        "is_decrease": {
          "default": false,
          "title": "Is Decrease",
          "type": "boolean"
        },
        "is_increase": {
          "default": false,
          "title": "Is Increase",
          "type": "boolean"
        },
        "loop_placement": {
          "$ref": "#/$defs/LoopPlacement"
        },
        "parent_stitch_ids": {
          "description": "Insertion targets: previous-round stitch IDs this stitch is worked into. Empty only for a magic-ring starting stitch, whose target is the ring itself, not a prior stitch \u2014 see `into_ring`.",
          "items": {
            "type": "string"
          },
          "title": "Parent Stitch Ids",
          "type": "array"
        },
        "position_in_round": {
          "description": "0-indexed position within the round.",
          "minimum": 0,
          "title": "Position In Round",
          "type": "integer"
        },
        "repeat_group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID of the RepeatOp iteration this stitch belongs to, if any.",
          "title": "Repeat Group Id"
        },
        "round_number": {
          "minimum": 1,
          "title": "Round Number",
          "type": "integer"
        },
        "sequence_index": {
          "description": "0-indexed global working order.",
          "minimum": 0,
          "title": "Sequence Index",
          "type": "integer"
        },
        "source_reference": {
          "description": "e.g. \"crown round 3 operation 2 (repeat 4/8)\".",
          "title": "Source Reference",
          "type": "string"
        },
        "stitch_height_category": {
          "enum": [
            "short",
            "medium",
            "tall"
          ],
          "title": "Stitch Height Category",
          "type": "string"
        },
        "stitch_id": {
          "description": "Stable ID, e.g. \"body-r04-s018\".",
          "title": "Stitch Id",
          "type": "string"
        },
        "stitch_type": {
          "$ref": "#/$defs/StitchFamily"
        },
        "target_rule": {
          "default": "deterministic_left_to_right",
          "enum": [
            "explicit",
            "deterministic_left_to_right"
          ],
          "title": "Target Rule",
          "type": "string"
        },
        "yarn_id": {
          "default": "main",
          "description": "Phase 1 supports solid-colour single yarn.",
          "title": "Yarn Id",
          "type": "string"
        }
      },
      "required": [
        "stitch_id",
        "component_kind",
        "round_number",
        "position_in_round",
        "sequence_index",
        "stitch_type",
        "stitch_height_category",
        "loop_placement",
        "source_reference"
      ],
      "title": "StitchNode",
      "type": "object"
    },
    "YarnSegment": {
      "description": "A simplified structural piece of yarn path owned by one stitch.\n\nThe first slice models only a single ``connector`` segment per\nyarn-sequence edge (previous stitch -> this stitch). Richer semantic\nsegmentation (entry/lower-loop/post/upper-loop/exit) is deferred to a\nlater slice, per the data model note in the geometry/rendering spec \u2014\nthis type is intentionally narrow, not final.",
      "properties": {
        "from_stitch_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Stitch Id"
        },
        "owning_stitch_id": {
          "title": "Owning Stitch Id",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "segment_type": {
          "const": "connector",
          "default": "connector",
          "title": "Segment Type",
          "type": "string"
        },
        "to_stitch_id": {
          "title": "To Stitch Id",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "owning_stitch_id",
        "to_stitch_id"
      ],
      "title": "YarnSegment",
      "type": "object"
    },
    "YarnSegmentGeometry": {
      "description": "Simplified curve for one yarn segment: a straight line between two stitches.\n\nFirst-slice simplification: two control points (start, end), not a full\nCatmull-Rom/Bezier centreline. See package docstring for what a later\nprocedural-yarn slice would add here without changing the schema shape\n(more control points, same record type).",
      "properties": {
        "control_points": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Control Points",
          "type": "array"
        },
        "from_stitch_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "From Stitch Id"
        },
        "owning_stitch_id": {
          "title": "Owning Stitch Id",
          "type": "string"
        },
        "radius_cm": {
          "exclusiveMinimum": 0,
          "title": "Radius Cm",
          "type": "number"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "segment_type": {
          "default": "connector",
          "title": "Segment Type",
          "type": "string"
        },
        "to_stitch_id": {
          "title": "To Stitch Id",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "owning_stitch_id",
        "from_stitch_id",
        "to_stitch_id",
